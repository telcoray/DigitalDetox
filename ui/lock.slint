// Full-screen lock screen shown during a detox session.
// Equivalent of LockWindow.xaml in the C# version, with the same layout and spacing.

import { Label, SymbolLabel, Theme } from "common.slint";

// Timer whose total width never changes: every digit gets a cell as wide as "0" and is
// centered in it, so narrow digits like "1" don't make the whole timer shift sideways.
component TimerDisplay inherits Rectangle {
    in property <[string]> chars;          // e.g. ["2", "5", ":", "0", "0"]
    in property <color> text-color;
    in property <length> size: 140px;

    // Invisible reference texts, only used to measure the cell widths
    digit-probe := Text { text: "0"; font-family: Theme.font; font-size: root.size; font-weight: 100; visible: false; }
    colon-probe := Text { text: ":"; font-family: Theme.font; font-size: root.size; font-weight: 100; visible: false; }

    min-height: digit-probe.preferred-height;

    HorizontalLayout {
        width: 100%;
        height: 100%;
        alignment: center;

        for ch in root.chars: Text {
            text: ch;
            width: ch == ":" ? colon-probe.preferred-width : digit-probe.preferred-width;
            font-family: Theme.font;
            font-size: root.size;
            font-weight: 100;
            color: root.text-color;
            horizontal-alignment: center;
        }
    }
}

// Transparent button with a thin border, like the Emergency Exit button of the C# version
component OutlineButton inherits Rectangle {
    in property <string> text;
    callback clicked();

    width: 300px;
    height: 50px;
    border-width: 2px;
    border-color: touch.has-hover ? Theme.outline-hover : Theme.outline;
    background: touch.pressed ? Theme.line : transparent;

    Label {
        text: root.text;
        font-size: 16px;
        font-weight: 500;
        color: Theme.text;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Breathing guide for Buteyko's reduced breathing. Two fixed rings mark the smallest and the
// largest size; the circle between them grows while breathing in, shrinks while breathing out
// and rests on the inner ring during the pause. It moves at a steady speed, so how far it still
// has to go shows how long the current phase will last.
component BreathingGuide inherits Rectangle {
    in property <duration> inhale: 2s;
    in property <duration> exhale: 3s;
    in property <duration> pause: 4s;

    // The layout gives it 220px when there's room, less on short screens
    preferred-width: 220px;
    preferred-height: 220px;
    min-width: 120px;
    min-height: 120px;

    property <length> size: min(root.width, root.height);
    property <length> inner: root.size * 0.4;
    // Where we are in the current breath, in milliseconds
    property <float> in-ms: root.inhale / 1ms;
    property <float> out-ms: root.exhale / 1ms;
    property <float> t: Math.mod(animation-tick() / 1ms, (root.inhale + root.exhale + root.pause) / 1ms);
    // 0 = on the inner ring, 1 = on the outer ring
    property <float> breath: root.t < root.in-ms ? root.t / root.in-ms
        : root.t < root.in-ms + root.out-ms ? 1 - (root.t - root.in-ms) / root.out-ms
        : 0;

    Rectangle {
        width: root.size;
        height: root.size;
        border-radius: self.width / 2;
        border-width: 2px;
        border-color: Theme.outline;
    }

    Rectangle {
        width: root.inner;
        height: root.inner;
        border-radius: self.width / 2;
        border-width: 2px;
        border-color: Theme.outline;
    }

    // Drawn last: during the pause it covers the inner ring, which then stays blue too
    Rectangle {
        width: root.inner + (root.size - root.inner) * root.breath;
        height: self.width;
        border-radius: self.width / 2;
        border-width: 2px;
        border-color: Theme.accent;
        background: Theme.accent-soft;
    }
}

// Black layer over the whole screen, used to dim it or turn it black. Rust sets both the level
// and how long the change takes: slow and gentle when darkening, quick when coming back.
component Shade inherits Rectangle {
    in property <float> level;          // 0 = invisible, 1 = completely black
    in property <duration> fade;

    width: 100%;
    height: 100%;
    background: black;
    opacity: root.level;

    animate opacity {
        duration: root.fade;
        easing: ease-in-out;
    }
}

// Shown on every secondary monitor: same background, title and timer, nothing to interact with
export component CoverWindow inherits Window {
    in property <[string]> time-chars;
    in property <bool> completed: false;
    in property <float> shade-level;
    in property <duration> shade-fade;

    title: "Digital Detox - Locked";
    icon: @image-url("../assets/logo.svg");
    background: Theme.background;
    always-on-top: true;
    no-frame: true;

    VerticalLayout {
        alignment: center;
        spacing: 20px;

        SymbolLabel {
            symbol: "🌿";
            text: "Time to Disconnect";
            font-size: 28px;
            font-weight: 700;
            color: Theme.title;
        }

        TimerDisplay {
            chars: root.time-chars;
            size: 72px;
            text-color: root.completed ? Theme.success : Theme.text;
        }
    }

    Shade {
        level: root.shade-level;
        fade: root.shade-fade;
    }
}

export component LockWindow inherits Window {
    // Values set from Rust (like x:Name'd controls updated from code-behind in WPF)
    in property <[string]> time-chars;
    in property <string> motivation;
    in property <string> unlock-text;
    in property <float> progress: 0;      // 0.0 → 1.0
    in property <bool> completed: false;

    // Emergency exit state. Rust counts the Ctrl+Shift+X presses; the UI handles the confirmation.
    in-out property <string> status-message;        // replaces the status line when not empty
    in-out property <bool> emergency-visible: false;
    property <bool> confirm-visible: false;

    // How dark the screen is (see Shade); driven by Rust's idle tracking
    in property <float> shade-level;
    in property <duration> shade-fade;
    // Shown during the last minute before the screen turns black
    in property <bool> more-time-visible: false;

    // The breathing guide fades out with the screen and then stops, so it doesn't keep
    // redrawing a black screen for the rest of the detox
    property <float> guide-opacity: root.completed || root.shade-level >= 1 ? 0 : 1;
    animate guide-opacity { duration: root.shade-fade; }

    callback emergency-key-pressed();
    callback exit-requested();
    callback turn-off-screen();
    callback more-time();

    title: "Digital Detox - Locked";
    icon: @image-url("../assets/logo.svg");
    background: Theme.background;
    always-on-top: true;
    no-frame: true;

    forward-focus: keys;

    keys := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if (event.modifiers.control && event.modifiers.shift && (event.text == "x" || event.text == "X")) {
                root.emergency-key-pressed();
                return accept;
            }
            reject
        }

        // Three bands like the WPF Grid (*, Auto, *): the timer block sits exactly in the
        // middle, the title hangs above it and the info below it
        VerticalLayout {
            // Top band: title + motivation, aligned to the bottom, 40px above the timer
            VerticalLayout {
                vertical-stretch: 1;
                alignment: end;
                padding-bottom: 40px;
                spacing: 10px;

                SymbolLabel {
                    symbol: "🌿";
                    text: "Time to Disconnect";
                    font-size: 28px;
                    font-weight: 700;
                    color: Theme.title;
                }

                Label {
                    text: root.motivation;
                    font-size: 18px;
                    color: Theme.subtle;
                }

                HorizontalLayout {
                    alignment: center;
                    padding-top: 20px;

                    BreathingGuide {
                        opacity: root.guide-opacity;
                        visible: root.guide-opacity > 0;
                    }
                }
            }

            // Middle band: timer, status, progress bar
            VerticalLayout {
                vertical-stretch: 0;

                TimerDisplay {
                    chars: root.time-chars;
                    text-color: root.completed ? Theme.success : Theme.text;
                }

                VerticalLayout {
                    padding-top: 15px;
                    if root.completed: SymbolLabel {
                        symbol: "✨";
                        text: "Detox Complete!";
                        font-size: 24px;
                        color: Theme.success;
                    }

                    if !root.completed: Label {
                        text: root.status-message != "" ? root.status-message : "Digital Detox in Progress";
                        font-size: 24px;
                        color: root.status-message != "" ? Theme.warning : Theme.muted;
                    }
                }

                // Progress bar: centered 400px track with a fill proportional to `progress`
                HorizontalLayout {
                    alignment: center;
                    padding-top: 30px;

                    Rectangle {
                        width: 400px;
                        height: 6px;
                        border-radius: 3px;
                        background: Theme.line;

                        Rectangle {
                            x: 0;
                            width: parent.width * root.progress;
                            height: parent.height;
                            border-radius: 3px;
                            background: root.completed ? Theme.success : Theme.accent;
                        }
                    }
                }

                VerticalLayout {
                    padding-top: 10px;
                    Label {
                        text: "\{Math.floor(root.progress * 100)}% complete";
                        font-size: 14px;
                        color: Theme.faint;
                    }
                }
            }

            // Bottom band: unlock info, aligned to the top, 40px below the progress bar
            VerticalLayout {
                vertical-stretch: 1;
                alignment: start;
                padding-top: 40px;
                spacing: 15px;

                Label {
                    text: "Your screen will unlock automatically when the timer ends.";
                    font-size: 16px;
                    color: Theme.faint;
                }

                Label {
                    text: root.unlock-text;
                    font-size: 14px;
                    color: Theme.muted;
                }

                // So you don't end up staring at the countdown: black screen now, monitor off shortly after
                // "+5 minutes" postpones the black screen, to keep following the breathing guide
                if !root.completed && !root.confirm-visible: HorizontalLayout {
                    alignment: center;
                    padding-top: 15px;
                    spacing: 20px;

                    OutlineButton {
                        width: 240px;
                        height: 44px;
                        text: "Turn off screen";
                        clicked => { root.turn-off-screen(); }
                    }

                    if root.more-time-visible: OutlineButton {
                        width: 240px;
                        height: 44px;
                        text: "+5 minutes";
                        clicked => { root.more-time(); }
                    }
                }

                // Appears after Ctrl+Shift+X has been pressed three times
                if root.emergency-visible && !root.confirm-visible: HorizontalLayout {
                    alignment: center;
                    padding-top: 15px;

                    OutlineButton {
                        text: "Emergency Exit";
                        clicked => { root.confirm-visible = true; }
                    }
                }

                // In-window confirmation, instead of the MessageBox of the C# version
                if root.confirm-visible: VerticalLayout {
                    padding-top: 15px;
                    spacing: 15px;

                    Label {
                        text: "Are you sure you want to end your detox early?\nYour progress will be lost.";
                        font-size: 16px;
                        color: Theme.title;
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 20px;

                        OutlineButton {
                            width: 220px;
                            text: "Yes, end detox";
                            clicked => { root.exit-requested(); }
                        }

                        OutlineButton {
                            width: 220px;
                            text: "No, keep going";
                            clicked => {
                                root.confirm-visible = false;
                                root.emergency-visible = false;
                                root.status-message = "";
                            }
                        }
                    }
                }
            }
        }

        // On top of everything else
        Shade {
            level: root.shade-level;
            fade: root.shade-fade;
        }
    }
}
