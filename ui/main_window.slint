// Main window where the duration is chosen. Same style as the lock screen: one dark background,
// a large thin number, quiet gray text and the blue accent.
// Two tabs, Detox and Pomodoro, each with an explanation section further down (scroll to see it).

import { Label, ScrollArea, Theme } from "common.slint";

// Rounded preset button ("5", "15", …); lights up in the accent color when selected
component PresetChip inherits Rectangle {
    in property <int> minutes;
    in property <bool> selected;
    callback clicked();

    height: 46px;
    min-width: 56px;
    horizontal-stretch: 1;
    border-radius: 10px;
    border-width: 1px;
    border-color: root.selected ? Theme.accent : touch.has-hover ? Theme.subtle : Theme.outline-hover;
    background: root.selected ? Theme.accent-soft : touch.has-hover ? #FFFFFF1A : #FFFFFF0D;

    Label {
        text: "\{root.minutes}";
        font-size: 18px;
        font-weight: 600;
        color: root.selected ? Theme.text : Theme.title;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Filled accent button for the main action of a screen
component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <color> fill: Theme.accent;
    in property <color> hover-color: Theme.accent-hover;
    in property <color> pressed-color: Theme.accent-pressed;
    callback clicked();

    height: 52px;
    border-radius: 10px;
    background: touch.pressed ? root.pressed-color : touch.has-hover ? root.hover-color : root.fill;

    Label {
        text: root.text;
        font-size: 18px;
        font-weight: 600;
        color: Theme.text;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Section below the first screen: a thin divider, a heading and its content
component Section inherits VerticalLayout {
    in property <string> title;

    padding-left: 28px;
    padding-right: 28px;
    padding-bottom: 32px;
    spacing: 10px;

    Rectangle {
        height: 1px;
        background: Theme.line;
    }

    VerticalLayout {
        padding-top: 18px;
        padding-bottom: 4px;

        Label {
            text: root.title;
            font-size: 18px;
            font-weight: 600;
            color: Theme.title;
            horizontal-alignment: left;
        }
    }

    @children
}

// Outlined button, for actions next to a filled one or that stop something
component SecondaryButton inherits Rectangle {
    in property <string> text;
    callback clicked();

    height: 52px;
    border-radius: 10px;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.subtle : Theme.outline-hover;
    background: touch.pressed ? #FFFFFF26 : touch.has-hover ? #FFFFFF1A : #FFFFFF0D;

    Label {
        text: root.text;
        font-size: 18px;
        font-weight: 600;
        color: Theme.text;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// "Detox | Pomodoro" switch at the top of the window
component TabBar inherits Rectangle {
    in property <[string]> tabs;
    in-out property <int> current;
    // Color of the selected tab
    in property <color> accent: Theme.accent;
    in property <color> accent-soft: Theme.accent-soft;

    height: 42px;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.outline;
    background: #FFFFFF0D;

    HorizontalLayout {
        padding: 4px;
        spacing: 4px;

        for tab[index] in root.tabs: Rectangle {
            horizontal-stretch: 1;
            border-radius: 7px;
            border-width: index == root.current ? 1px : 0px;
            border-color: root.accent;
            background: index == root.current ? root.accent-soft : touch.has-hover ? #FFFFFF0D : transparent;

            Label {
                text: tab;
                font-size: 15px;
                font-weight: 600;
                color: index == root.current ? Theme.text : Theme.muted;
                vertical-alignment: center;
            }

            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.current = index; }
            }
        }
    }
}

// One dot per Pomodoro round: done ones filled, the current one ringed in tomato red
component RoundDots inherits HorizontalLayout {
    in property <int> rounds: 4;
    in property <int> current;
    in property <bool> running;

    alignment: center;
    spacing: 10px;

    for index in root.rounds: Rectangle {
        width: 12px;
        height: 12px;
        border-radius: 6px;
        border-width: 1px;
        border-color: root.running && index + 1 <= root.current ? Theme.tomato : Theme.outline-hover;
        background: root.running && index + 1 < root.current ? Theme.tomato : transparent;
    }

    Label {
        text: "Round \{root.current} of \{root.rounds}";
        font-size: 14px;
        color: Theme.muted;
        vertical-alignment: center;
    }
}

export component MainWindow inherits Window {
    // 0 = Detox, 1 = Pomodoro
    in-out property <int> tab: 0;

    in-out property <string> minutes-text: "25";
    in-out property <string> error-text;
    in property <string> unlock-text;       // "Unlocks at 21:15", kept up to date by Rust

    // The Pomodoro, kept up to date by Rust: "24:59", "until your 5-minute break", "Break at 21:15"
    in property <bool> pomodoro-running;
    in property <int> pomodoro-round: 1;
    in property <string> pomodoro-time;
    in property <string> pomodoro-caption;
    in property <string> pomodoro-info;

    // Flipped by Rust after the window comes back from being minimized, see `backdrop` below
    in property <bool> repaint-flip;

    // Rust filters what is typed (digits only, max 3), updates the unlock time and starts the detox
    callback minutes-edited(string);
    callback start-clicked();
    // Starts the Pomodoro, or stops it when it's running
    callback pomodoro-clicked();

    title: "Digital Detox";
    icon: @image-url("../assets/logo.svg");
    // Fixed size. 400x480 gives whole pixels at 100/125/150/175% display scaling:
    // with fractional sizes a 1px unpainted (white) line appears on the right and bottom edges.
    width: 400px;
    height: 480px;
    background: Theme.background;

    // Workaround for a Slint software-renderer bug on Windows: after the window is restored from
    // the taskbar only the parts that changed get repainted, and the rest of the window stays
    // empty. Changing this full-size backdrop by an invisible 1/255 step forces a full repaint.
    backdrop := Rectangle {
        width: 100%;
        height: 100%;
        background: root.repaint-flip ? #1A1A2F : Theme.background;
    }

    scroll := ScrollArea {
        width: 100%;
        height: 100%;

        // First screen, exactly as tall as the window: everything needed to start
        VerticalLayout {
            height: scroll.height;
            padding-left: 28px;
            padding-right: 28px;
            padding-top: 24px;
            padding-bottom: 28px;

            TabBar {
                tabs: ["Detox", "Pomodoro"];
                current <=> root.tab;
                accent: root.tab == 1 ? Theme.tomato : Theme.accent;
                accent-soft: root.tab == 1 ? Theme.tomato-soft : Theme.accent-soft;
            }

            if root.tab == 0: VerticalLayout {
                vertical-stretch: 1;

                VerticalLayout {
                    padding-top: 20px;

                    Label {
                        text: "How long do you want to disconnect?";
                        font-size: 16px;
                        color: Theme.muted;
                    }
                }

                // The duration, large and thin like the lock screen timer. Click it to type a value.
                VerticalLayout {
                    vertical-stretch: 1;
                    alignment: center;

                    TextInput {
                        text <=> root.minutes-text;
                        input-type: number;
                        font-family: Theme.font;
                        font-size: 84px;
                        font-weight: 100;
                        color: Theme.text;
                        selection-background-color: Theme.accent-soft;
                        horizontal-alignment: center;
                        edited => { root.minutes-edited(self.text); }
                        // Enter starts the detox, like clicking the button
                        accepted => { root.start-clicked(); }
                    }

                    Label {
                        text: "minutes";
                        font-size: 16px;
                        color: Theme.muted;
                    }
                }

                // Equal-width presets spanning the same width as the Start button
                HorizontalLayout {
                    spacing: 8px;

                    for minutes in [5, 15, 25, 45, 60]: PresetChip {
                        minutes: minutes;
                        selected: root.minutes-text == "\{minutes}";
                        clicked => {
                            root.minutes-text = "\{minutes}";
                            root.minutes-edited(root.minutes-text);
                        }
                    }
                }

                // When the detox would end, or what's wrong with the value typed
                VerticalLayout {
                    padding-top: 16px;
                    padding-bottom: 12px;

                    Label {
                        min-height: 20px;
                        text: root.error-text != "" ? root.error-text : root.unlock-text;
                        font-size: 14px;
                        color: root.error-text != "" ? Theme.error : Theme.faint;
                    }
                }

                PrimaryButton {
                    text: "Start detox";
                    clicked => { root.start-clicked(); }
                }
            }

            // Same layout as the Detox tab, so switching tabs doesn't move things around
            if root.tab == 1: VerticalLayout {
                vertical-stretch: 1;

                VerticalLayout {
                    padding-top: 20px;

                    Label {
                        text: root.pomodoro-running ? "Stay focused" : "Work in focused rounds";
                        font-size: 16px;
                        color: Theme.muted;
                    }
                }

                // Work time: 25:00 before starting, then the countdown to the break
                VerticalLayout {
                    vertical-stretch: 1;
                    alignment: center;

                    Label {
                        text: root.pomodoro-time;
                        font-size: 84px;
                        font-weight: 100;
                        color: Theme.text;
                    }

                    Label {
                        text: root.pomodoro-caption;
                        font-size: 16px;
                        color: Theme.muted;
                    }
                }

                VerticalLayout {
                    height: 46px;
                    alignment: center;

                    RoundDots {
                        current: root.pomodoro-round;
                        running: root.pomodoro-running;
                    }
                }

                VerticalLayout {
                    padding-top: 16px;
                    padding-bottom: 12px;

                    Label {
                        min-height: 20px;
                        text: root.pomodoro-info;
                        font-size: 14px;
                        color: Theme.faint;
                    }
                }

                if !root.pomodoro-running: PrimaryButton {
                    text: "Start Pomodoro";
                    fill: Theme.tomato;
                    hover-color: Theme.tomato-hover;
                    pressed-color: Theme.tomato-pressed;
                    clicked => { root.pomodoro-clicked(); }
                }

                if root.pomodoro-running: SecondaryButton {
                    text: "Stop Pomodoro";
                    clicked => { root.pomodoro-clicked(); }
                }
            }
        }

        if root.tab == 0: Section {
            title: "What happens next?";

            for line in [
                "• Full-screen overlay will appear",
                "• Cannot be closed until timer ends",
                "• Alt+Tab, Win key, Alt+F4 blocked",
                "• Screen auto-unlocks when time is up",
            ]: Label {
                text: line;
                font-size: 15px;
                color: Theme.muted;
                horizontal-alignment: left;
            }
        }

        if root.tab == 1: Section {
            title: "How does it work?";

            for line in [
                "• 25 minutes of focus, PC free",
                "• Then the screen locks for a 5-minute break",
                "• Every 4th break lasts 15 minutes",
                "• A reminder appears 1 minute before",
                "• Repeats until you stop it",
            ]: Label {
                text: line;
                font-size: 15px;
                color: Theme.muted;
                horizontal-alignment: left;
            }
        }
    }
}
