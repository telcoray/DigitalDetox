<Window x:Class="DigitalDetox.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Digital Detox - Locked"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#1A1A2E"
        KeyDown="Window_KeyDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Deactivated="Window_Deactivated">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Bottom" Margin="0,0,0,40">
            <TextBlock x:Name="TitleText" Text="🌿 Time to Disconnect" FontFamily="Segoe UI" FontSize="28" Foreground="#ECF0F1" HorizontalAlignment="Center" FontWeight="Bold" />
            <TextBlock x:Name="MotivationText" Text="Take a deep breath. Relax your shoulders." FontFamily="Segoe UI" FontSize="18" Foreground="#BDC3C7" HorizontalAlignment="Center" Margin="0,10,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="TimerText" Text="25:00" FontFamily="Segoe UI" FontSize="140" FontWeight="Thin" Foreground="#FFFFFF" HorizontalAlignment="Center" />
            <TextBlock x:Name="StatusText" Text="Digital Detox in Progress" FontFamily="Segoe UI" FontSize="24" Foreground="#95A5A6" HorizontalAlignment="Center" Margin="0,15,0,0" />
            
            <Border Width="400" Height="6" Background="#2C3E50" CornerRadius="3" Margin="0,30,0,0">
                <Border x:Name="ProgressFill" Width="0" Height="6" Background="#3498DB" CornerRadius="3" HorizontalAlignment="Left" />
            </Border>
            
            <TextBlock x:Name="ProgressText" Text="0% complete" FontFamily="Segoe UI" FontSize="14" Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,10,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="2" VerticalAlignment="Top" Margin="0,40,0,60">
            <TextBlock Text="Your screen will unlock automatically when the timer ends." FontFamily="Segoe UI" FontSize="16" Foreground="#7F8C8D" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="600" />
            <TextBlock x:Name="EndTimeText" Text="" FontFamily="Segoe UI" FontSize="14" Foreground="#95A5A6" HorizontalAlignment="Center" Margin="0,15,0,0" />
            
            <Button x:Name="EmergencyExitButton" 
                    Content="Emergency Exit (Ctrl+Shift+X)" 
                    Background="Transparent"
                    Foreground="#FFFFFF"
                    FontFamily="Segoe UI"
                    FontSize="16"
                    FontWeight="Medium"
                    Padding="30,15"
                    BorderBrush="#34495E"
                    BorderThickness="2"
                    Width="300" 
                    Height="50"
                    Margin="0,30,0,0"
                    Visibility="Collapsed"
                    Click="EmergencyExitButton_Click" />
        </StackPanel>
    </Grid>
</Window>